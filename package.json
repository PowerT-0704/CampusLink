{
  "name": "campus-link-liquid",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "岚连 · CDUTYB 专版（液态玻璃版）—— 面向成都理工大学（宜宾校区）的校园网连接工具（基于 Campus Link）",
  "author": "岚连 · CDUTYB 专版（液态玻璃版）（基于 NingMeng123 的 Campus Link）",
  "homepage": "https://github.com/PowerT-0704/CampusLink",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/smoke-desktop.cjs",
    "test:release": "node --test scripts/release/*.test.cjs",
    "dist:win": "npm run build && node scripts/release/build.cjs win x64",
    "pack:win": "npm run build && electron-builder --win --x64 --dir --publish never",
    "dist:mac": "npm run build && node scripts/release/build.cjs mac x64 && node scripts/release/build.cjs mac arm64",
    "dist:mac:x64": "npm run build && node scripts/release/build.cjs mac x64",
    "dist:mac:arm64": "npm run build && node scripts/release/build.cjs mac arm64"
  },
  "dependencies": {
    "@samasante/liquid-glass": "0.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "cn.campuslink.glass",
    "productName": "岚连 · CDUTYB 专版（液态玻璃版）",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "examples/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "Campus-Link-Glass-Setup-${version}.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "artifactName": "Campus-Link-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "shortcutName": "岚连 · CDUTYB 专版（液态玻璃版）",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    }
  }
}
